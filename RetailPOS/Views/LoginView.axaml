<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RetailPOS.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="RetailPOS.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid>
        <!-- Windows 7 Aero Aurora Background -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="50%,40%" RadiusX="80%" RadiusY="80%">
                    <GradientStop Color="#235A8E" Offset="0.0" />
                    <GradientStop Color="#143B60" Offset="0.5" />
                    <GradientStop Color="#091A2C" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Clean, Clutter-Free Windows 7 Logon Dialog Card -->
        <Border Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#D0152F4E" CornerRadius="10" BorderBrush="#509BE0" BorderThickness="1.5"
                Padding="32,28" BoxShadow="0 14 36 0 #80000000">

            <StackPanel Spacing="16">

                <!-- Windows 7 Account Emblem & Header -->
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <Border Width="64" Height="64" CornerRadius="8" Background="#1D4E75" BorderBrush="#5CAEE6" BorderThickness="2" HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="RetailPOS Log On" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="Enter your credentials to access the register" FontSize="11" Foreground="#B0D5F5" HorizontalAlignment="Center" />
                </StackPanel>

                <Separator Background="#3A6C9E" Height="1" Margin="0,2" />

                <!-- Simple User ID & Password Form -->
                <StackPanel Spacing="12">

                    <!-- User ID -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="User ID / Username:" FontSize="12" FontWeight="SemiBold" Foreground="#E0EEFA" />
                        <TextBox Classes="win7-input"
                                 Text="{Binding UserId}"
                                 PlaceholderText="e.g. admin or sarah"
                                 Height="36" FontSize="14" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Password / PIN:" FontSize="12" FontWeight="SemiBold" Foreground="#E0EEFA" />
                        <TextBox Classes="win7-input"
                                 Text="{Binding Password}"
                                 PasswordChar="●"
                                 PlaceholderText="Enter PIN / Password"
                                 Height="36" FontSize="16" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Error Alert -->
                    <Border Background="#99DD2222" CornerRadius="4" Padding="10,6"
                            IsVisible="{Binding HasError}" BorderBrush="#FF6666" BorderThickness="1">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                    </Border>

                    <!-- Windows 7 Aero Log On Button -->
                    <Button Classes="win7-button-primary"
                            Command="{Binding SubmitLoginCommand}"
                            Content="Log On ➔"
                            Height="42"
                            FontSize="15"
                            FontWeight="Bold"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0,4,0,0" />
                </StackPanel>

                <!-- Clean Hint at Bottom -->
                <Border Background="#1A3450" CornerRadius="4" Padding="8,5">
                    <TextBlock Text="Default accounts: admin (1234) | sarah (1111) | david (2222)"
                               FontSize="10.5" Foreground="#99CCE6" HorizontalAlignment="Center" />
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
