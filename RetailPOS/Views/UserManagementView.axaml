<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RetailPOS.ViewModels"
             xmlns:m="using:RetailPOS.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:Class="RetailPOS.Views.UserManagementView"
             x:DataType="vm:UserManagementViewModel">

    <Grid>
        <!-- Main User Management Container -->
        <Border Margin="10" Background="#FFFFFF" CornerRadius="4" BorderBrush="#90AFC9" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- Windows 7 Control Panel Style Header -->
                <Border Grid.Row="0" Background="#E2EEF8" BorderBrush="#B2CCE0" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="4" Background="#1C5282" BorderBrush="#5299D3" BorderThickness="1.5">
                                <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="User Accounts &amp; Staff Management" FontSize="16" FontWeight="Bold" Foreground="#123456" />
                                <TextBlock Text="Create, modify, and manage shop cashiers and administrator privileges" FontSize="11" Foreground="#557595" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="win7-button-primary"
                                    Command="{Binding OpenAddModalCommand}"
                                    Content="➕ Add Staff Account" Height="32" />
                            <Button Classes="win7-button"
                                    Command="{Binding OpenEditModalCommand}"
                                    CommandParameter="{Binding SelectedUser}"
                                    Content="✏️ Edit Selected" Height="32" />
                            <Button Classes="win7-button-danger"
                                    Command="{Binding PromptDeleteUserCommand}"
                                    CommandParameter="{Binding SelectedUser}"
                                    Content="🚫 Deactivate" Height="32" />
                            <Button Classes="win7-button"
                                    Command="{Binding RefreshUsers}"
                                    Content="⟳ Refresh" Height="32" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status / Alert Banner -->
                <Border Grid.Row="1" Background="#F1F6FB" BorderBrush="#CADCEB" BorderThickness="0,0,0,1" Padding="12,6">
                    <TextBlock Text="{Binding StatusMessage, FallbackValue='Select an account to view or edit staff permissions.'}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#1F5A8E" />
                </Border>

                <!-- Users Table -->
                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="#D8E8F5" BorderBrush="#AEC9E0" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid ColumnDefinitions="50,160,180,140,90,100,160,*">
                            <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" Foreground="#1E446B" />
                            <TextBlock Grid.Column="1" Text="Full Name" FontWeight="Bold" Foreground="#1E446B" />
                            <TextBlock Grid.Column="2" Text="Username" FontWeight="Bold" Foreground="#1E446B" />
                            <TextBlock Grid.Column="3" Text="Role" FontWeight="Bold" Foreground="#1E446B" />
                            <TextBlock Grid.Column="4" Text="Security PIN" FontWeight="Bold" Foreground="#1E446B" />
                            <TextBlock Grid.Column="5" Text="Status" FontWeight="Bold" Foreground="#1E446B" />
                            <TextBlock Grid.Column="6" Text="Created Date" FontWeight="Bold" Foreground="#1E446B" />
                            <TextBlock Grid.Column="7" Text="Actions" FontWeight="Bold" Foreground="#1E446B" TextAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="m:User">
                                <Grid ColumnDefinitions="50,160,180,140,90,100,160,*" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="👤" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding FullName}" FontWeight="Bold" Foreground="#173552" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Username}" Foreground="#446688" VerticalAlignment="Center" />

                                    <!-- Role Badge -->
                                    <Border Grid.Column="3" CornerRadius="3" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="#D4E8F8">
                                        <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="11" Foreground="#174A78" />
                                    </Border>

                                    <TextBlock Grid.Column="4" Text="{Binding Pin}" FontWeight="Bold" Foreground="#667788" VerticalAlignment="Center" />

                                    <!-- Active Status -->
                                    <Border Grid.Column="5" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="#E2F4E6">
                                        <TextBlock Text="Active" FontSize="11" FontWeight="Bold" Foreground="#186A2B" />
                                    </Border>

                                    <TextBlock Grid.Column="6" Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd'}" Foreground="#778899" FontSize="11" VerticalAlignment="Center" />

                                    <!-- Quick Actions -->
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button Classes="win7-button"
                                                Command="{Binding $parent[UserControl].((vm:UserManagementViewModel)DataContext).OpenEditModalCommand}"
                                                CommandParameter="{Binding}"
                                                Content="Edit" Padding="8,2" FontSize="11" />
                                        <Button Classes="win7-button-danger"
                                                Command="{Binding $parent[UserControl].((vm:UserManagementViewModel)DataContext).PromptDeleteUserCommand}"
                                                CommandParameter="{Binding}"
                                                Content="Deactivate" Padding="8,2" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Bottom Helper Bar -->
                <Border Grid.Row="3" Background="#E7F0F8" BorderBrush="#B6D0E4" BorderThickness="0,1,0,0" Padding="12,6">
                    <TextBlock Text="🔒 Security Notice: Cashiers can only access the POS Register, Loyalty, and Sales History. Administrator role grants full product catalog CRUD, master data setup, and user management."
                               FontSize="11" Foreground="#446E94" />
                </Border>

            </Grid>
        </Border>

        <!-- ADD / EDIT USER MODAL DIALOG -->
        <Border IsVisible="{Binding IsEditModalOpen}"
                Background="#88000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Width="450" Background="#FFFFFF" CornerRadius="8"
                    BorderBrush="#2B6B9C" BorderThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 10 30 0 #A0000000" Padding="20">
                <StackPanel Spacing="12">

                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding ModalTitle}" FontSize="16" FontWeight="Bold" Foreground="#1A4064" />
                        <Button Classes="win7-button-danger" Grid.Column="1"
                                Command="{Binding CloseEditModalCommand}"
                                Content="✕" Width="26" Height="26" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </Grid>
                    <Separator Background="#C3D9EB" Height="1" />

                    <!-- Error Banner -->
                    <Border Background="#FEE8E8" BorderBrush="#DD6666" BorderThickness="1" CornerRadius="3"
                            Padding="8,4" IsVisible="{Binding HasFormError}">
                        <TextBlock Text="{Binding FormError}" Foreground="#B01111" FontWeight="SemiBold" FontSize="12" />
                    </Border>

                    <!-- Form Inputs -->
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4">

                        <!-- Full Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                        <TextBox Classes="win7-input" Grid.Row="0" Grid.Column="1" Text="{Binding EditFullName}" Height="30" Margin="0,5" />

                        <!-- Username -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Username:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                        <TextBox Classes="win7-input" Grid.Row="1" Grid.Column="1" Text="{Binding EditUsername}" Height="30" Margin="0,5" />

                        <!-- PIN -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Security PIN:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                        <TextBox Classes="win7-input" Grid.Row="2" Grid.Column="1" Text="{Binding EditPin}" PlaceholderText="4-digit numeric PIN" Height="30" Margin="0,5" />

                        <!-- Role -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Account Role:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding EditRole}" Height="30" Margin="0,5" HorizontalAlignment="Stretch" />

                        <!-- Active Checkbox -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Active Status:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                        <CheckBox Grid.Row="4" Grid.Column="1" Content="Account is Active (Can log in)" IsChecked="{Binding EditIsActive}" Margin="0,5" />
                    </Grid>

                    <Separator Background="#C3D9EB" Height="1" Margin="0,6" />

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*,*">
                        <Button Classes="win7-button-primary" Grid.Column="0"
                                Command="{Binding SaveUserFormCommand}"
                                Content="💾 Save Staff Account" Margin="0,0,6,0"
                                HorizontalContentAlignment="Center" Height="36" />
                        <Button Classes="win7-button" Grid.Column="1"
                                Command="{Binding CloseEditModalCommand}"
                                Content="Cancel" Margin="6,0,0,0"
                                HorizontalContentAlignment="Center" Height="36" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- DELETE WARNING MODAL: USER DEACTIVATION CONFIRMATION -->
        <Border IsVisible="{Binding IsDeleteModalOpen}"
                Background="#88000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Width="430" Background="#FFFFFF" CornerRadius="8"
                    BorderBrush="#C43B3B" BorderThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 10 30 0 #A0000000" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="42" Height="42" CornerRadius="21" Background="#FFF2D6" BorderBrush="#F0A624" BorderThickness="2" VerticalAlignment="Top">
                            <TextBlock Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Confirm Account Deactivation" FontSize="16" FontWeight="Bold" Foreground="#8B1818" />
                            <TextBlock Text="{Binding DeleteTargetName, StringFormat='Are you sure you want to deactivate staff account &quot;{0}&quot;? They will no longer be able to log in to the POS system.'}"
                                       FontSize="12" Foreground="#444444" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="#E0E0E0" Height="1" />

                    <Grid ColumnDefinitions="*,*">
                        <Button Classes="win7-button-danger" Grid.Column="0"
                                Command="{Binding ConfirmDeleteUserCommand}"
                                Content="Yes, Deactivate Account" Height="36"
                                HorizontalContentAlignment="Center" Margin="0,0,6,0" />
                        <Button Classes="win7-button" Grid.Column="1"
                                Command="{Binding CancelDeleteUserCommand}"
                                Content="Cancel" Height="36"
                                HorizontalContentAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
