<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RetailPOS.ViewModels"
             xmlns:m="using:RetailPOS.Models"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="800"
             x:Class="RetailPOS.Views.MasterDataView"
             x:DataType="vm:MasterDataViewModel">

    <Grid>
        <!-- Main Master Data Container -->
        <Border Margin="10" Background="#FFFFFF" CornerRadius="4" BorderBrush="#90AFC9" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- Header (Windows 7 Control Panel Style) -->
                <Border Grid.Row="0" Background="#E2EDF7" BorderBrush="#B2CDE0" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#1B517E" BorderBrush="#55A0DA" BorderThickness="2">
                                <TextBlock Text="⚙️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Master Data &amp; Store Setup" FontSize="16" FontWeight="Bold" Foreground="#123250" />
                                <TextBlock Text="Configure VAT / Tax rates, Currency, Store Profile, and Grocery Categories" FontSize="11" Foreground="#557595" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="win7-button-primary"
                                    Command="{Binding SaveAllSettingsCommand}"
                                    Content="💾 Save All Settings" Height="34" />
                            <Button Classes="win7-button"
                                    Command="{Binding LoadSettings}"
                                    Content="⟳ Reload" Height="34" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status Banner -->
                <Border Grid.Row="1" Background="#F1F6FB" BorderBrush="#C9DCED" BorderThickness="0,0,0,1" Padding="12,6">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#1C5E94" />
                </Border>

                <!-- 2-Column Split: General & Financial Setup (Left) vs Category Setup (Right) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid ColumnDefinitions="*,*" Margin="14">

                        <!-- LEFT COLUMN: VAT TAX, CURRENCY & STORE SETUP -->
                        <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,10,0">

                            <!-- Section 1: VAT / Tax Configuration -->
                            <Border Background="#F9FCFE" BorderBrush="#BED4E6" BorderThickness="1" CornerRadius="4" Padding="14">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🏷️" FontSize="16" />
                                        <TextBlock Text="VAT &amp; Tax Configuration" FontSize="14" FontWeight="Bold" Foreground="#164A78" />
                                    </StackPanel>
                                    <Separator Background="#D0E2F0" Height="1" />

                                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tax / VAT Name:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="0" Grid.Column="1" Text="{Binding TaxName}" PlaceholderText="e.g. VAT, Sales Tax, GST" Height="30" Margin="0,5" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tax Rate (%):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="1" Grid.Column="1" Text="{Binding TaxRatePercent}" PlaceholderText="e.g. 5.0, 7.5, 10.0" Height="30" Margin="0,5" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tax Registration ID:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="2" Grid.Column="1" Text="{Binding TaxId}" PlaceholderText="e.g. TAX ID: 88-3419024" Height="30" Margin="0,5" />
                                    </Grid>
                                    <TextBlock Text="💡 Note: Tax is automatically applied to all grocery sales register transactions." FontSize="11" Foreground="#557595" />
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Currency Setup -->
                            <Border Background="#F9FCFE" BorderBrush="#BED4E6" BorderThickness="1" CornerRadius="4" Padding="14">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="💱" FontSize="16" />
                                        <TextBlock Text="Currency Configuration" FontSize="14" FontWeight="Bold" Foreground="#164A78" />
                                    </StackPanel>
                                    <Separator Background="#D0E2F0" Height="1" />

                                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" Margin="0,4">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Currency Symbol:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="0" Grid.Column="1" Text="{Binding CurrencySymbol}" PlaceholderText="e.g. $, €, £, ৳, ₹, ¥" Height="30" Margin="0,5" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Currency Code:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="1" Grid.Column="1" Text="{Binding CurrencyCode}" PlaceholderText="e.g. USD, EUR, BDT, INR" Height="30" Margin="0,5" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Section 3: Loyalty Point Rules Setup -->
                            <Border Background="#F9FCFE" BorderBrush="#BED4E6" BorderThickness="1" CornerRadius="4" Padding="14">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="⭐" FontSize="16" />
                                        <TextBlock Text="Loyalty Point Calculation &amp; Redeem Rules" FontSize="14" FontWeight="Bold" Foreground="#164A78" />
                                    </StackPanel>
                                    <Separator Background="#D0E2F0" Height="1" />

                                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Earn Rate (pts per $1):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="0" Grid.Column="1" Text="{Binding PointsPerDollarSpent}" Height="30" Margin="0,5" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Redeem Value ($ per pt):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="1" Grid.Column="1" Text="{Binding PointRedeemValue}" PlaceholderText="0.05 = 20 pts gives $1" Height="30" Margin="0,5" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Min Points to Redeem:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="2" Grid.Column="1" Text="{Binding MinPointsToRedeem}" Height="30" Margin="0,5" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Section 4: Store Profile & Receipt Footer -->
                            <Border Background="#F9FCFE" BorderBrush="#BED4E6" BorderThickness="1" CornerRadius="4" Padding="14">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🏬" FontSize="16" />
                                        <TextBlock Text="Store Details &amp; Receipt Slip Branding" FontSize="14" FontWeight="Bold" Foreground="#164A78" />
                                    </StackPanel>
                                    <Separator Background="#D0E2F0" Height="1" />

                                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Store Name:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="0" Grid.Column="1" Text="{Binding StoreName}" Height="30" Margin="0,5" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Store Address:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="1" Grid.Column="1" Text="{Binding StoreAddress}" Height="30" Margin="0,5" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone Number:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="2" Grid.Column="1" Text="{Binding StorePhone}" Height="30" Margin="0,5" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Receipt Footer:" VerticalAlignment="Top" FontWeight="SemiBold" Margin="0,5" />
                                        <TextBox Classes="win7-input" Grid.Row="3" Grid.Column="1" Text="{Binding ReceiptFooter}" AcceptsReturn="True" Height="60" Margin="0,5" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- RIGHT COLUMN: CATEGORY MASTER DATA SETUP -->
                        <Border Grid.Column="1" Background="#F9FCFE" BorderBrush="#BED4E6" BorderThickness="1" CornerRadius="4" Padding="14" Margin="10,0,0,0">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🗂️" FontSize="16" />
                                    <TextBlock Text="Grocery Category Master Data" FontSize="14" FontWeight="Bold" Foreground="#164A78" />
                                </StackPanel>
                                <Separator Grid.Row="1" Background="#D0E2F0" Height="1" Margin="0,10" />

                                <!-- Add Category Form -->
                                <Border Grid.Row="2" Background="#EAF3FA" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Add New Category:" FontWeight="Bold" FontSize="12" Foreground="#123456" />
                                        <Grid ColumnDefinitions="*,*,Auto">
                                            <TextBox Classes="win7-input" Grid.Column="0"
                                                     Text="{Binding NewCategoryName}"
                                                     PlaceholderText="Category Name (e.g. Frozen Foods)" Height="30" Margin="0,0,6,0" />
                                            <TextBox Classes="win7-input" Grid.Column="1"
                                                     Text="{Binding NewCategoryDescription}"
                                                     PlaceholderText="Description (optional)" Height="30" Margin="0,0,6,0" />
                                            <Button Classes="win7-button-primary" Grid.Column="2"
                                                    Command="{Binding AddCategoryCommand}"
                                                    Content="➕ Add Category" Height="30" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Table Header -->
                                <Border Grid.Row="3" Background="#D8E8F5" BorderBrush="#AEC9E0" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid ColumnDefinitions="140,*,80">
                                        <TextBlock Grid.Column="0" Text="Category Name" FontWeight="Bold" Foreground="#1E446B" />
                                        <TextBlock Grid.Column="1" Text="Description" FontWeight="Bold" Foreground="#1E446B" />
                                        <TextBlock Grid.Column="2" Text="Action" FontWeight="Bold" Foreground="#1E446B" TextAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Categories List -->
                                <ListBox Grid.Row="4" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="m:CategoryItem">
                                            <Grid ColumnDefinitions="140,*,80" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Foreground="#183B5E" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#557799" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button Classes="win7-button-danger" Grid.Column="2"
                                                        Command="{Binding $parent[UserControl].((vm:MasterDataViewModel)DataContext).PromptDeleteCategoryCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="Delete" Padding="6,2" FontSize="11" HorizontalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                    </Grid>
                </ScrollViewer>

                <!-- Status Strip -->
                <Border Grid.Row="3" Background="#E7F0F8" BorderBrush="#B6D0E4" BorderThickness="0,1,0,0" Padding="12,6">
                    <TextBlock Text="🔒 Master Data Changes apply immediately across the POS Register, product catalog, customer loyalty calculations, and thermal receipts."
                               FontSize="11" Foreground="#446E94" />
                </Border>
            </Grid>
        </Border>

        <!-- DELETE WARNING MODAL: CATEGORY DELETION CONFIRMATION -->
        <Border IsVisible="{Binding IsDeleteModalOpen}"
                Background="#88000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Width="420" Background="#FFFFFF" CornerRadius="8"
                    BorderBrush="#C43B3B" BorderThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 10 30 0 #A0000000" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="42" Height="42" CornerRadius="21" Background="#FFF2D6" BorderBrush="#F0A624" BorderThickness="2" VerticalAlignment="Top">
                            <TextBlock Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Confirm Category Deletion" FontSize="16" FontWeight="Bold" Foreground="#8B1818" />
                            <TextBlock Text="{Binding DeleteTargetName, StringFormat='Are you sure you want to delete category &quot;{0}&quot;? Existing products in this category will keep their label.'}"
                                       FontSize="12" Foreground="#444444" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="#E0E0E0" Height="1" />

                    <Grid ColumnDefinitions="*,*">
                        <Button Classes="win7-button-danger" Grid.Column="0"
                                Command="{Binding ConfirmDeleteCategoryCommand}"
                                Content="Yes, Delete Category" Height="36"
                                HorizontalContentAlignment="Center" Margin="0,0,6,0" />
                        <Button Classes="win7-button" Grid.Column="1"
                                Command="{Binding CancelDeleteCategoryCommand}"
                                Content="Cancel" Height="36"
                                HorizontalContentAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
